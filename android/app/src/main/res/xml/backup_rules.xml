<?xml version="1.0" encoding="utf-8"?>
<!--
  Back up ONLY the Flutter preferences file. It holds the viewer's stable
  `User-xxxxx` id and saved phone number, so a reinstall / new phone restores the
  same account instead of minting a new id and losing the paid package.
  Everything else (databases, cached files) stays excluded.
-->
<full-backup-content>
    <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
</full-backup-content>
