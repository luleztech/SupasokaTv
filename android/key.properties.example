# Copy to android/key.properties and fill in (do not commit key.properties).
# Copy your existing keystore into android/app/ — e.g. my-release-key.keystore from the React Native project.
#
# Matches the React Native release signing defaults in android/app/build.gradle:
#   keyAlias my-key-alias
#   storeFile my-release-key.keystore

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=my-key-alias
storeFile=my-release-key.keystore
