NODE_ENV=development
# Railway injects PORT (often 8080). Match your Railway service settings.
PORT=8080
# Comma-separated origins, or * — for Flutter web on Railway use:
# CORS_ORIGIN=https://supasokatv-production.up.railway.app
CORS_ORIGIN=*
# Required for POST /api/v1/admin/import — same value in SupaAdmin Settings.
# ADMIN_API_KEY=your-long-random-secret
