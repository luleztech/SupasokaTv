NODE_ENV=development
PORT=8080
CORS_ORIGIN=*

# Postgres (Railway plugin or manual)
# DATABASE_URL=postgresql://...

# —— Recommended: SupaAdmin signs in with password (no API key in the mobile app) ——
# Long random string (e.g. openssl rand -hex 32)
JWT_SECRET=
# Password you type in SupaAdmin → Settings (must match exactly)
ADMIN_APP_PASSWORD=

# —— ZenoPay (server-side verification + premium activation) ——
ZENO_API_KEY=
# Optional override; keep default unless Zeno gives a different host.
ZENO_API_BASE=https://zenoapi.com

# —— Firebase Cloud Messaging (server-to-device push from SupaAdmin) ——
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste service-account private_key with escaped newlines (\n).
FCM_PRIVATE_KEY=
# Optional (local/dev): absolute path to service-account json file.
# FCM_SERVICE_ACCOUNT_PATH=/absolute/path/to/serviceAccountKey.json
# Optional: full JSON as one env var instead of the 3 vars above.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# —— Optional legacy: curl / CI only (header X-Admin-Key). Not used by SupaAdmin mobile. ——
# ADMIN_API_KEY=
