NODE_ENV=development
PORT=8080
CORS_ORIGIN=*

# Postgres (Railway plugin or manual)
# DATABASE_URL=postgresql://...

# —— Recommended: SupaAdmin signs in with password (no API key in the mobile app) ——
# Long random string (e.g. openssl rand -hex 32)
JWT_SECRET=
# Password you type in SupaAdmin → Settings (must match exactly)
ADMIN_APP_PASSWORD=

# Optional fallback only when app_settings has no payment_provider row (SupaAdmin DB wins when set)
# PAYMENT_PROVIDER=sonicpesa

# —— SonicPesa (copy the SAME values from EaMax Railway — one shared merchant account) ——
SONICPESA_API_KEY=
SONICPESA_SECRET_KEY=
# Or: SONICPESA_API_SECRET / SONICPESA_SECRETE_KEY (EaMax aliases)
SONICPESA_WEBHOOK_SECRET=
# Webhook URL in SonicPesa dashboard:
# https://supasokatv-production.up.railway.app/api/v1/public/sonicpesa/webhook
# SonicPesa requires buyer_phone in the international 255XXXXXXXXX format.

# —— Aurax Pay (fallback when Sonic cannot push Vodacom M-Pesa or Halopesa STK) ——
# AURAXPAY_API_KEY=
# AURAXPAY_WEBHOOK_SECRET=
# AURAXPAY_WEBHOOK_URL=https://supasokatv-production.up.railway.app/api/v1/public/aurax/webhook
# AURAXPAY_BASE_URL=https://api.auraxpay.net/v1
# PUBLIC_BASE_URL=https://supasokatv-production.up.railway.app

# —— Firebase Cloud Messaging (server-to-device push from SupaAdmin) ——
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste service-account private_key with escaped newlines (\n).
FCM_PRIVATE_KEY=
# Optional (local/dev): absolute path to service-account json file.
# FCM_SERVICE_ACCOUNT_PATH=/absolute/path/to/serviceAccountKey.json
# Optional: full JSON as one env var instead of the 3 vars above.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# —— Mirror SupaAdmin push to EaMax user app (same secret on EaMax: SUPA_EAMAX_BRIDGE_SECRET) ——
# EAMAX_API_BASE_URL=https://eamax-production.up.railway.app
# EAMAX_BRIDGE_SECRET=

# —— Mirror SupaAdmin push to JamboPlus (same secret on JamboPlus: SUPA_JAMBOPLUS_BRIDGE_SECRET) ——
# JAMBOPLUS_API_BASE_URL=https://jamboplus-production.up.railway.app
# JAMBOPLUS_BRIDGE_SECRET=

# —— Optional legacy: curl / CI only (header X-Admin-Key). Not used by SupaAdmin mobile. ——
# ADMIN_API_KEY=
